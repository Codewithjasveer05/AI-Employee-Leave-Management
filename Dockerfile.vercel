FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src

COPY ["AIEmployeeLeaveManagement/AIEmployeeLeaveManagement.csproj", "AIEmployeeLeaveManagement/"]

RUN dotnet restore "AIEmployeeLeaveManagement/AIEmployeeLeaveManagement.csproj"

COPY . .

WORKDIR "/src/AIEmployeeLeaveManagement"

RUN dotnet publish "AIEmployeeLeaveManagement.csproj" \
    -c Release \
    -o /app/publish \
    --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final

WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:80

EXPOSE 80

ENTRYPOINT ["dotnet", "AIEmployeeLeaveManagement.dll"]