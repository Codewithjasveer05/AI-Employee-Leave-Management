<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Leave Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="LeaveRequests" asp-action="Index">AI Employee Leave Management</a>
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="LeaveRequests" asp-action="Index">Leave Records</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="LeaveRequests" asp-action="Create">Apply Leave</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="LeaveRequests" asp-action="Analyze">AI Analysis</a>
                    </li>
                </ul>
                <span class="navbar-text">Roll No: 34</span>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3">
        AI-Based Employee Leave Management System - TYIT Sem V
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>